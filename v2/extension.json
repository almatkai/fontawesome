{
  "schemaVersion": 3,
  "id": "com.tezbar.native.fontawesome",
  "slug": "fontawesome",
  "name": "Font Awesome",
  "version": "2.0.0",
  "description": "Search Font Awesome icons",
  "icon": "resources/command-icon.png",
  "runtime": "rust",
  "execution": "process",
  "protocolVersion": 1,
  "repository": "https://github.com/almatkai/fontawesome",
  "author": "almatkai",
  "platforms": [
    "macOS",
    "Windows"
  ],
  "commands": [
    {
      "name": "index",
      "title": "Search Font Awesome",
      "mode": "view",
      "runtime": "rust",
      "platforms": [
        "macOS",
        "Windows"
      ],
      "concurrency": "serialize",
      "timeoutMs": 60000,
      "refreshMs": null
    }
  ],
  "preferences": [
    {
      "name": "API_TOKEN",
      "type": "password",
      "required": false,
      "title": "API Token (For Font Awesome Pro Accounts)",
      "description": "Optionally use Font Awesome Pro icons and custom kits by providing an API Token. Not necessary to access free icons."
    },
    {
      "name": "STYLE_PREFERENCE",
      "type": "dropdown",
      "default": "fas",
      "required": false,
      "data": [
        {
          "title": "Classic, Solid",
          "value": "fas"
        },
        {
          "title": "Classic, Regular (Pro only)",
          "value": "far"
        },
        {
          "title": "Classic, Light (Pro only)",
          "value": "fal"
        },
        {
          "title": "Classic, Thin (Pro only)",
          "value": "fat"
        },
        {
          "title": "Classic, Brands",
          "value": "fab"
        },
        {
          "title": "Duotone, Solid (Pro only)",
          "value": "fad"
        },
        {
          "title": "Sharp, Solid (Pro only)",
          "value": "fass"
        },
        {
          "title": "Sharp, Regular (Pro only)",
          "value": "fasr"
        },
        {
          "title": "Sharp, Light (Pro only)",
          "value": "fasl"
        },
        {
          "title": "Sharp, Thin (Pro only)",
          "value": "fast"
        }
      ],
      "title": "Icon family and style preference",
      "description": "Choose which icon family and style you prefer."
    },
    {
      "name": "PRIMARY_ACTION",
      "type": "dropdown",
      "default": "copyIconName",
      "required": false,
      "data": [
        {
          "title": "Copy Icon Name",
          "value": "copyIconName"
        },
        {
          "title": "Copy Icon Classes",
          "value": "copyIconClasses"
        },
        {
          "title": "Copy as Svg",
          "value": "copyAsSvg"
        },
        {
          "title": "Copy Icon Glyph",
          "value": "copyIconGlyph"
        },
        {
          "title": "Copy Icon Unicode",
          "value": "copyIconUnicode"
        }
      ],
      "title": "Icon primary action",
      "description": "Choose which action to perform when selecting an icon."
    },
    {
      "name": "REMEMBER_LAST_KIT",
      "type": "checkbox",
      "required": false,
      "default": false,
      "label": "Remember Last Used Kit",
      "description": "When enabled, the extension will open with your previously selected icon style or custom kit."
    },
    {
      "name": "KIT_FILTER",
      "type": "textfield",
      "required": false,
      "title": "Filter Custom Kits",
      "description": "Limit which custom kits appear in the dropdown. Enter kit names or IDs separated by commas (e.g., \"My Icons, abc123\"). Leave empty to show all kits."
    }
  ],
  "replaces": [
    "raycast.fontawesome",
    "com.tezbar.fontawesome"
  ],
  "capabilities": [
    "clipboard.write",
    "settings.open"
  ],
  "artifacts": {},
  "verification": [
    {
      "platform": "macOS",
      "state": "not-run",
      "note": "Real desktop acceptance has not been run."
    },
    {
      "platform": "Windows",
      "state": "not-run",
      "note": "Real desktop acceptance has not been run."
    }
  ]
}
