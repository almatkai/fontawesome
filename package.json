{
  "$schema": "https://www.raycast.com/schemas/extension.json",
  "name": "font-awesome",
  "title": "Font Awesome",
  "description": "Search Font Awesome icons",
  "icon": "assets/command-icon.png",
  "author": "almatkai",
  "contributors": [
    "GLaDO8",
    "danielferguson",
    "ridemountainpig",
    "yusifaliyevpro",
    "xmok",
    "j3lte",
    "hellonicolas"
  ],
  "categories": [
    "Design Tools",
    "Developer Tools"
  ],
  "license": "MIT",
  "commands": [
    {
      "name": "index",
      "title": "Search Font Awesome",
      "description": "Search Font Awesome icons",
      "mode": "view",
      "platforms": [
        "macOS",
        "Windows"
      ]
    }
  ],
  "preferences": [
    {
      "name": "API_TOKEN",
      "type": "password",
      "required": false,
      "title": "API Token (For Font Awesome Pro Accounts)",
      "description": "Optionally use Font Awesome Pro icons and custom kits by providing an API Token. Not necessary to access free icons."
    },
    {
      "name": "STYLE_PREFERENCE",
      "type": "dropdown",
      "default": "fas",
      "required": false,
      "data": [
        {
          "title": "Classic, Solid",
          "value": "fas"
        },
        {
          "title": "Classic, Regular (Pro only)",
          "value": "far"
        },
        {
          "title": "Classic, Light (Pro only)",
          "value": "fal"
        },
        {
          "title": "Classic, Thin (Pro only)",
          "value": "fat"
        },
        {
          "title": "Classic, Brands",
          "value": "fab"
        },
        {
          "title": "Duotone, Solid (Pro only)",
          "value": "fad"
        },
        {
          "title": "Sharp, Solid (Pro only)",
          "value": "fass"
        },
        {
          "title": "Sharp, Regular (Pro only)",
          "value": "fasr"
        },
        {
          "title": "Sharp, Light (Pro only)",
          "value": "fasl"
        },
        {
          "title": "Sharp, Thin (Pro only)",
          "value": "fast"
        }
      ],
      "title": "Icon family and style preference",
      "description": "Choose which icon family and style you prefer."
    },
    {
      "name": "PRIMARY_ACTION",
      "type": "dropdown",
      "default": "copyIconName",
      "required": false,
      "data": [
        {
          "title": "Copy Icon Name",
          "value": "copyIconName"
        },
        {
          "title": "Copy Icon Classes",
          "value": "copyIconClasses"
        },
        {
          "title": "Copy as Svg",
          "value": "copyAsSvg"
        },
        {
          "title": "Copy Icon Glyph",
          "value": "copyIconGlyph"
        },
        {
          "title": "Copy Icon Unicode",
          "value": "copyIconUnicode"
        }
      ],
      "title": "Icon primary action",
      "description": "Choose which action to perform when selecting an icon."
    },
    {
      "name": "REMEMBER_LAST_KIT",
      "type": "checkbox",
      "required": false,
      "default": false,
      "label": "Remember Last Used Kit",
      "description": "When enabled, the extension will open with your previously selected icon style or custom kit."
    },
    {
      "name": "KIT_FILTER",
      "type": "textfield",
      "required": false,
      "title": "Filter Custom Kits",
      "description": "Limit which custom kits appear in the dropdown. Enter kit names or IDs separated by commas (e.g., \"My Icons, abc123\"). Leave empty to show all kits."
    }
  ],
  "dependencies": {
    "@raycast/api": "^1.104.1",
    "@raycast/utils": "^2.2.1"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "tsx": "^4.22.4",
    "typescript": "^5.9.3"
  },
  "scripts": {
    "build": "ray build -e dist",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test test/*.test.ts"
  },
  "platforms": [
    "macOS",
    "Windows"
  ],
  "id": "com.tezbar.fontawesome",
  "version": "0.1.0",
  "tezbar": {
    "schemaVersion": 1,
    "platforms": [
      "macos",
      "windows"
    ],
    "linuxStatus": "coming-soon",
    "repository": "https://github.com/almatkai/fontawesome",
    "upstream": {
      "repository": "https://github.com/raycast/extensions",
      "path": "extensions/fontawesome",
      "commit": "6734d85992290066fd31a7f5bee3cca3d3545a1a"
    }
  }
}
